# Copy this to .env and fill in real values before running Playwright.
# Both the backend (port 3000) and Angular dev server (port 4200) must be running.

# Frontend URL (defaults to http://localhost:4200 if omitted)
CLIENT_URL=http://localhost:4200

# API base URL used by the test helpers for setup/teardown
E2E_API_URL=http://localhost:3000/api/v1

# A coach account that exists in the development database
E2E_COACH_EMAIL=coach@example.com
E2E_COACH_PASSWORD=CoachPass1234

# An admin account used only for API-level cleanup (delete test players after tests).
# IMPORTANT: The backend's loginValidate requires the password to match
#   /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)[A-Za-z\d]{8,}$/
# i.e. alphanumeric only, at least one uppercase, one lowercase, one digit.
# If your admin was seeded with a password containing special chars (e.g. 7afiz@2026!)
# it will fail validation and cleanup will be skipped — tests will still pass, but
# test players will accumulate in the dev DB until manually removed.
E2E_ADMIN_EMAIL=admin@talentrada.com
E2E_ADMIN_PASSWORD=AdminPass1234
