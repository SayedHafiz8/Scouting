PORT=8000
CLIENT_URL=http://localhost:4200
NODE_ENV=development
CONNECTION_STRING=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

JWT_SECRET_KEY=<your-strong-random-secret-min-32-chars>
JWT_EXPIRE_TIME=30m
JWT_REFRESH_SECRET=<your-strong-random-refresh-secret-min-32-chars>
JWT_REFRESH_EXPIRE_TIME=7d

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=<your-email@gmail.com>
EMAIL_PASS=<your-gmail-app-password>

# ── Bunny Stream (video) ─────────────────────────────────────────────────────
BUNNY_STREAM_LIBRARY_ID=<your-stream-library-id>
BUNNY_STREAM_API_KEY=<stream-management-api-key>            # create/get/delete video (server-side)
BUNNY_STREAM_TOKEN_AUTH_KEY=<library-token-authentication-key>  # signs playback tokens (F1) — NOT the API key
BUNNY_STREAM_CDN_HOSTNAME=<your-library>.b-cdn.net          # pull-zone host of the Stream library
BUNNY_STREAM_WEBHOOK_SECRET=<long-random-unguessable-string>    # webhook mounts at /webhooks/bunny/<secret>
BUNNY_MAX_VIDEO_MB=50                                       # F2 hard size cap (delete + fail above this)
BUNNY_MAX_VIDEO_SECONDS=0                                   # optional duration cap (0 = off)
BUNNY_MAX_VIDEOS_PER_PLAYER_MATCH=5                         # F8 finished-video cap per (player, match)
BUNNY_MAX_FAILED_ATTEMPTS_PER_PLAYER_MATCH=5               # F8 oversize-attempt lockout threshold

# ── Bunny Storage "media" zone (avatars + scouting images) — CDN pull zone ON, Token Auth ON ──
BUNNY_STORAGE_MEDIA_ZONE=<media-storage-zone-name>
BUNNY_STORAGE_MEDIA_API_KEY=<media-zone-storage-password>
BUNNY_MEDIA_CDN_HOSTNAME=<media-zone-pullzone>.b-cdn.net
BUNNY_MEDIA_TOKEN_AUTH_KEY=<media-pullzone-token-auth-key>  # F4 signed image URLs

# ── Bunny Storage "vault" zone (national ID cards) — NO pull zone / NO CDN (C3) ──
BUNNY_STORAGE_VAULT_ZONE=<vault-storage-zone-name>
BUNNY_STORAGE_VAULT_API_KEY=<vault-zone-storage-password>

# Account-level API key — used only for CDN Purge on the media zone after delete/replace (F5)
BUNNY_ACCOUNT_API_KEY=<bunny-account-api-key>

# Media retention window in days (mediaRetention cron; default 90)
MEDIA_RETENTION_DAYS=90

# Video reconcile cron — the ONLY path that resolves a video's status on localhost,
# since Bunny's webhook cannot reach a local dev server. Defaults (10min stuck
# threshold, every 5min) are production-tuned; for local testing you can speed
# this up e.g.:
# VIDEO_RECONCILE_STUCK_MINUTES=1
# VIDEO_RECONCILE_CRON=*/1 * * * *

# Rate limiting (all optional — defaults shown are used if unset)
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=15
REFRESH_RATE_LIMIT_MAX=60
FORGOT_PASSWORD_RATE_LIMIT_MAX=5
